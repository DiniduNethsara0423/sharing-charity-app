# Example environment variables for express-mysql-backend
# Copy this file to .env and fill values before running the app

# App secret
JWT_SECRET=your_jwt_secret_here

# MySQL / Sequelize
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=root
DB_PASS=secret

# SMTP (email) - used by src/services/mailService.js
# Either provide SMTP credentials or use a mail provider SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mededconnectdev@gmail.com
SMTP_PASS=xbek vqev fnyh keov

# Firebase service account - either provide a path to the JSON file
# on the server or paste the JSON content as a single-line string.
# src/services/fcmService.js reads these variables.
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
# or
FIREBASE_SERVICE_ACCOUNT_JSON={ }

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Optional: other env vars used across the app
# PORT=3000
# NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=1234
DB_NAME=charity_app
JWT_SECRET=your-secret-key-change-in-production
